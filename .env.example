# API key。走中转站就填中转站的 key，走 Anthropic 官方就填 sk-ant-xxx
ANTHROPIC_API_KEY=sk-xxxxxxxx

# 中转站地址。用 Anthropic 官方 API 就把这行删掉/注释掉
# 注意结尾不要带 /v1，SDK 会自己拼 /v1/messages
ANTHROPIC_BASE_URL=https://thebestai.net

# 模型。可选：deepseek-v4-flash / deepseek-v4-pro / claude-opus-5 ...
AGENT_MODEL=deepseek-v4-flash

# 思维链默认折叠成进度点。想看完整思考过程改成 1
SHOW_THINKING=0
